with handler {
  x => (x, "");
  print(s, k) => k (()) match { (x, acc) => (x, s ^ acc) }
} handle {

//   ^ the default print handler 

with handler {
  x => x;
  read(x, k) => k("Bob ")
} handle {
    #print("What is your forename? ");
    val forename = #read(());
    #print("What is your surname? ");
    val surename = #read(());
    #print(forename ^ surename)
}

}